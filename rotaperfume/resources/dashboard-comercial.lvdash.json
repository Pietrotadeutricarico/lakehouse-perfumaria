{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (grao de item)",
      "queryLines": [
        "SELECT data_pedido, ano, mes, canal, segmento, cidade,\n",
        "       marca, categoria, pedido_id, receita, margem\n",
        "FROM fato_vendas\n"
      ]
    },
    {
      "name": "ds_kpis",
      "displayName": "KPIs (uma linha)",
      "queryLines": [
        "SELECT SUM(receita) AS receita,\n",
        "       SUM(margem)  AS margem,\n",
        "       COUNT(DISTINCT pedido_id) AS pedidos,\n",
        "       SUM(receita) / COUNT(DISTINCT pedido_id) AS ticket_medio\n",
        "FROM fato_vendas\n"
      ]
    },
    {
      "name": "ds_categoria",
      "displayName": "Margem por categoria",
      "queryLines": [
        "SELECT categoria,\n",
        "       SUM(receita) AS receita,\n",
        "       SUM(margem) / SUM(receita) AS margem_pct\n",
        "FROM fato_vendas\n",
        "GROUP BY categoria\n",
        "ORDER BY margem_pct\n"
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top 20 clientes",
      "queryLines": [
        "SELECT razao_social, segmento, cidade,\n",
        "       SUM(receita) AS receita,\n",
        "       SUM(margem)  AS margem,\n",
        "       COUNT(DISTINCT pedido_id) AS pedidos\n",
        "FROM fato_vendas\n",
        "GROUP BY razao_social, segmento, cidade\n",
        "ORDER BY receita DESC\n",
        "LIMIT 20\n"
      ]
    },
    {
      "name": "ds_fila",
      "displayName": "Fila da semana",
      "queryLines": [
        "SELECT vendedor, ordem, cliente_id, razao_social, cidade, uf,\n",
        "       score, faixa, ticket_medio, motivo, sugestao\n",
        "FROM fila_semanal\n",
        "ORDER BY vendedor, ordem\n"
      ]
    }
  ],
